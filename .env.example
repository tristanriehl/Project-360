# ==============================================================================
# PROJET 360 - CONFIGURATION D'EXÉCUTION
# ==============================================================================

# Option 1: GOOGLE GEMINI (Recommandé pour Vision OCR, extraction PDF & synthèse RAG)
# Obtenez votre clé API gratuite sur : https://aistudio.google.com/
# Si cette clé est renseignée, Projet 360 utilise automatiquement Gemini Flash.
GEMINI_API_KEY=

# Option 2: MODÈLE LOCAL (OLLAMA / LM STUDIO)
# Mettez USE_LOCAL_LLM="true" si vous souhaitez utiliser Ollama sans clé Gemini
USE_LOCAL_LLM=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# PORT: Port du serveur de développement (par défaut 3000)
PORT=3000
