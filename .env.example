# ==============================================================================
# PROJET 360 - CONFIGURATION D'EXÉCUTION
# ==============================================================================

# Option 1: MODÈLE LOCAL (OLLAMA / LM STUDIO) - 100% Hors-ligne, Illimité, Gratuit
# Définissez USE_LOCAL_LLM="true" pour forcer l'utilisation de votre modèle local
USE_LOCAL_LLM="true"

# Endpoint Ollama (par défaut sur port 11434) ou LM Studio (http://localhost:1234/v1)
OLLAMA_HOST="http://localhost:11434"

# Modèle Ollama installé sur votre machine (ex: llama3.2, mistral, qwen2.5, phi3)
OLLAMA_MODEL="llama3.2"

# Option 2: CLÉ GOOGLE GEMINI (Optionnel - Laisser vide pour utiliser le modèle local)
GEMINI_API_KEY=""

# PORT: Port du serveur de développement (par défaut 3000)
PORT=3000
